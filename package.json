{
  "name": "anvil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "anvil": "node src/cli.mjs",
    "chatgpt:login": "node scripts/chatgpt-login.mjs",
    "chatgpt:probe": "node scripts/chatgpt-probe.mjs",
    "test": "node --test test/*.test.mjs && npm run test:desktop",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "test:desktop": "tsx --test test/desktop/*.test.ts",
    "test:e2e": "playwright test",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "jose": "6.2.14",
    "lucide-react": "1.65.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A desktop coding workspace with a model-agnostic agent harness",
  "main": "out/main/index.js",
  "author": "bazingaedward",
  "overrides": {
    "dompurify": "3.4.17"
  }
}
